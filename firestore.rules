rules_version = '2';
// Addrio Tasks: only the four approved Gmail accounts get in.
// Sharon (admin) creates units, moves statuses and changes owners; everyone else reads, comments and adds ideas.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth != null && request.auth.token.email_verified == true ? request.auth.token.email : '';
    }
    function who() {
      return {
        's.rozenblit.office@gmail.com': 'sharon',
        'liambengalw@gmail.com': 'liam',
        'yovelbenazaria@gmail.com': 'yuval',
        'idobenazaria@gmail.com': 'ido'
      }.get(email(), '');
    }
    function member() { return who() != ''; }
    function admin() { return who() == 'sharon'; }

    match /units/{id} {
      allow read: if member();
      allow create, delete: if admin();
      allow update: if admin() || (member()
        && request.resource.data.status == resource.data.status
        && request.resource.data.owner == resource.data.owner);
    }
    match /drafts/{id} {
      allow read: if member();
      allow write: if admin();
    }
    match /ideas/{id} {
      allow read: if member();
      allow create, update: if member();
      allow delete: if admin();
    }
    match /msgs/{person} {
      allow read, write: if admin() || who() == person;
    }
    match /meta/areas {
      allow read, write: if member();
    }
    match /meta/{doc} {
      allow read: if member();
      allow write: if admin();
    }
    match /users/{person} {
      allow read, write: if who() == person;
    }
    match /sprints/{n} {
      allow read: if member();
      allow write: if admin();
    }
  }
}
